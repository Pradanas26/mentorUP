# ============================================================
# .env.example — Configuración del entorno de Laravel
# Copia este archivo como .env y rellena los datos
# ============================================================

APP_NAME=MentorUP
APP_ENV=local
APP_KEY=                    # Se genera con: php artisan key:generate
APP_DEBUG=true
APP_URL=http://localhost:8000

# ── BASE DE DATOS ────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mentorup        # Nombre de tu base de datos
DB_USERNAME=root            # Tu usuario de MySQL
DB_PASSWORD=                # Tu contraseña de MySQL

# ── SESIONES Y CACHÉ ─────────────────────────────────────────
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── CORS: permite peticiones desde el frontend React ─────────
SANCTUM_STATEFUL_DOMAINS=localhost:5173
